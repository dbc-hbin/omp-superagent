+		expect(isUnknownLongValueCandidate("--session-settings")).toBe(false);
+		expect(parseArgs([]).sessionSettings).toBeUndefined();
+		expect(parseArgs(["--session-settings", "--model-preset", "high"]).modelPreset).toBe("high");
+		expect(parseArgs(["--session-settings", "--model-preset=middle"]).modelPreset).toBe("middle");
