@@ -0,0 +1,225 @@
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as net from "node:net";
+import * as os from "node:os";
+import * as path from "node:path";
+import { Readable } from "node:stream";
+import { RpcClient, type RpcAgentProcess } from "../src/modes/rpc/rpc-client";
+import { validateRpcSocketPath } from "../src/modes/rpc/rpc-socket-host";
+import { LocalCollabSocket } from "../src/collab/local-client";
+import { COLLAB_PROTO, type CollabFrame } from "../src/collab/protocol";
+import { mintSessionId } from "../src/session/session-manager";
+import type { SessionEntry } from "../src/session/session-entries";
+import { createSessionManager } from "../src/main";
+import { parseArgs } from "../src/cli/args";
+import { Settings } from "../src/config/settings";
+
+function socketProcess(socketPath: string): RpcAgentProcess {
+	const socket = net.createConnection(socketPath);
+	const exited = Promise.withResolvers<number>();
+	socket.on("error", () => socket.destroy());
+	socket.once("close", () => exited.resolve(0));
+	return {
+		stdin: { write: data => socket.write(data) },
+		stdout: Readable.toWeb(socket) as ReadableStream<Uint8Array>,
+		peekStderr: () => "",
+		kill: () => socket.destroy(),
+		exited: exited.promise,
+	};
+}
+
+function nextFrame(socket: LocalCollabSocket, predicate: (frame: CollabFrame) => boolean): Promise<CollabFrame> {
+	const { promise, resolve, reject } = Promise.withResolvers<CollabFrame>();
+	const previous = socket.onFrame;
+	const timeout = setTimeout(() => { socket.onFrame = previous; reject(new Error("Timed out waiting for native Collab frame")); }, 10_000);
+	socket.onFrame = (frame, peer) => {
+		previous?.(frame, peer);
+		if (!predicate(frame)) return;
+		clearTimeout(timeout);
+		socket.onFrame = previous;
+		resolve(frame);
+	};
+	return promise;
+}
+
+describe("process-owned local RPC host", () => {
+	let root: string;
+	let socketPath: string;
+	let child: ReturnType<typeof Bun.spawn>;
+	let stderr: Promise<string>;
+	const clients: RpcClient[] = [];
+	const views: LocalCollabSocket[] = [];
+
+	async function connect(): Promise<RpcClient> {
+		const client = new RpcClient({ spawn: () => socketProcess(socketPath) });
+		clients.push(client);
+		await client.start();
+		return client;
+	}
+
+	beforeEach(async () => {
+		// Short private path fits macOS sockaddr_un even when TMPDIR is long.
+		root = await fs.mkdtemp(path.join(process.platform === "darwin" ? "/private/tmp" : os.tmpdir(), "omp-host-test-"));
+		await fs.chmod(root, 0o700);
+		socketPath = path.join(root, "host.sock");
+		child = Bun.spawn([process.execPath, path.join(import.meta.dir, "fixtures/fork-rpc-agent.ts"), root, socketPath], {
+			cwd: root, stdin: "ignore", stdout: "ignore", stderr: "pipe",
+			env: { ...Bun.env, PI_CODING_AGENT_DIR: path.join(root, "config"), PI_NO_TITLE: "1", PI_NOTIFICATIONS: "off" },
+		});
+		stderr = new Response(child.stderr as ReadableStream<Uint8Array>).text();
+		const deadline = Date.now() + 20_000;
+		while (true) {
+			try { await fs.lstat(socketPath); break; } catch (error) {
+				if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+			}
+			if (child.exitCode !== null) throw new Error(`Host exited: ${await stderr}`);
+			if (Date.now() > deadline) throw new Error("Host did not listen");
+			await Bun.sleep(10);
+		}
+	});
+
+	afterEach(async () => {
+		for (const view of views.splice(0)) view.close();
+		await Promise.all(clients.splice(0).map(client => client.stop()));
+		child?.kill();
+		await child?.exited;
+		await fs.rm(root, { recursive: true, force: true });
+	});
+
+	test("isolates same request ids and event filters, and persists after every client disconnects", async () => {
+		const a = await connect();
+		const b = await connect();
+		const [state, messages] = await Promise.all([
+			a.request({ type: "get_state" }, { id: "same" }),
+			b.request({ type: "get_messages" }, { id: "same" }),
+		]);
+		expect(state).toMatchObject({ id: "same", command: "get_state", success: true, data: { hostPid: child.pid, pendingUiRequests: [] } });
+		expect(messages).toMatchObject({ id: "same", command: "get_messages", success: true, data: { messages: [] } });
+		await a.setEventFilter([]);
+		await b.promptAndWait("first");
+		await Promise.all([a.stop(), b.stop()]);
+		const reconnected = await connect();
+		expect((await reconnected.getMessages()).some(message => message.role === "assistant")).toBe(true);
+		await reconnected.shutdownHost();
+		expect(await child.exited).toBe(0);
+		expect((await fs.readFile(path.join(root, "socket-session.jsonl"), "utf8"))).toContain("Done");
+	}, 30_000);
+
+	test("a running turn survives controller loss and prevents shutdown until settled", async () => {
+		const owner = await connect();
+		const started = Promise.withResolvers<void>();
+		owner.onSessionEvent(event => { if (event.type === "notice" && event.message === "slow turn streaming") started.resolve(); });
+		await owner.request({ type: "prompt", message: "slow" }, { id: "durable-turn" });
+		await started.promise;
+		await owner.stop();
+		const next = await connect();
+		expect((await next.getState()).isStreaming).toBe(true);
+		await expect(next.shutdownHost()).rejects.toMatchObject({ code: "session_busy" });
+		await next.abort();
+		await next.waitForSettled();
+		await next.shutdownHost();
+		expect(await child.exited).toBe(0);
+	}, 30_000);
+
+	test("native Collab snapshots are read-only and viewer disconnect never stops the worker", async () => {
