+
+	it("keeps real TUI /model hub assignments local while recording a restorable session model", async () => {
+		using dir = TempDir.createSync("@omp-model-hub-session-settings-");
+		const initialModel = getBundledModel("anthropic", "claude-sonnet-4-5");
+		const targetModel = getBundledModel("anthropic", "claude-sonnet-4-6");
+		if (!initialModel || !targetModel) throw new Error("Expected bundled Anthropic test models");
+		const agentDir = dir.join("agent");
+		const configPath = path.join(agentDir, "config.yml");
+		const modelsPath = path.join(agentDir, "models.yml");
+		const initialSelector = `${initialModel.provider}/${initialModel.id}`;
+		const targetSelector = `${targetModel.provider}/${targetModel.id}`;
+		await Bun.write(configPath, JSON.stringify({
+			modelRoles: { default: initialSelector, judge: initialSelector },
+			retry: { fallbackChains: { judge: [targetSelector] } },
+		}));
+		await Bun.write(modelsPath, "{\"providers\":{}}\n");
+		const nativeSettings = await Settings.loadIsolated({ cwd: dir.path(), agentDir });
+		const settings = nativeSettings.overlay();
+		const configBefore = await Bun.file(configPath).bytes();
+		const modelsBefore = await Bun.file(modelsPath).bytes();
+		const authStorage = createInMemoryAuthStorage();
+		authStorage.keys.setRuntime("anthropic", "session-settings-test-key");
+		const modelRegistry = new ModelRegistry(authStorage, modelsPath, { settings });
+		const sessionManager = SessionManager.create(dir.path(), dir.join("sessions"));
+		const session = new AgentSession({
+			agent: new Agent({ initialState: { model: initialModel, systemPrompt: ["Test"], tools: [], messages: [] } }),
+			sessionManager,
+			settings,
+			modelRegistry,
+		});
+		let mounted: Component | undefined;
+		const assigned = Promise.withResolvers<void>();
+		const ctx = createInteractiveModeContext({
+			settings,
+			session,
+			sessionManager,
+			statusLine: { invalidate: () => assigned.resolve() },
+			ui: {
+				showOverlay: component => {
+					mounted = component;
+					return { hide() {}, setHidden() {}, isHidden: () => false } satisfies OverlayHandle;
+				},
+			},
+		});
+		try {
+			await initTheme(false);
+			await sessionManager.ensureOnDisk();
+			expect(nativeSettings.settingsScope).toBe("persistent");
+			expect(settings.settingsScope).toBe("session");
+			expect(settings.mirrorState().settingsScope).toBe("session");
+			const mirror = Settings.mirror({
+				write: () => settings.mirrorState(),
+				refresh: async () => settings.mirrorState(),
+				cloneForCwd: cwd => settings.cloneForCwd(cwd),
+			}, settings.mirrorState());
+			expect(mirror.settingsScope).toBe("session");
+			await expect(applySessionModelPreset(nativeSettings, session, "low")).rejects.toThrow("requires session settings");
+			await expect(applySessionModelPreset(settings, session, "low", { modelRoles: { default: 42 } })).rejects.toThrow("Invalid model preset");
+			const frozen = {
+				modelRoles: { default: initialSelector, judge: initialSelector, smol: targetSelector },
+				defaultThinkingLevel: Effort.Low,
+			};
+			cfgModelPresets.override(settings, { low: frozen });
+			const applied = await applySessionModelPreset(settings, session, "low");
+			expect(applied.settingsScope).toBe("session");
+			expect(applied.preset).toEqual(frozen);
+			expect(applied.model.id).toBe(initialModel.id);
+			expect(session.thinkingLevel).toBe(Effort.Low);
+			const liveSnapshot = { ...frozen, defaultThinkingLevel: Effort.High };
+			const liveApplied = await applySessionModelPreset(settings, session, "high", liveSnapshot);
+			expect(liveApplied.preset).toEqual(liveSnapshot);
+			expect(session.thinkingLevel).toBe(Effort.High);
+			expect(Object.keys(cfgModelPresets.get(settings)).sort()).toEqual(["high", "low"]);
+			expect(cfgModelPresets.get(nativeSettings)).toEqual({});
+			expect(nativeSettings.getModelRole("smol")).toBeUndefined();
+			expect(await Bun.file(configPath).bytes()).toEqual(configBefore);
+			expect(await Bun.file(modelsPath).bytes()).toEqual(modelsBefore);
+			new SelectorController(ctx).showModelSelector();
+			expect(mounted).toBeInstanceOf(ModelHubComponent);
+			if (!(mounted instanceof ModelHubComponent)) throw new Error("Expected the native /model role hub");
+			for (const char of targetModel.id) mounted.handleInput(char);
+			mounted.handleInput("\n"); // Matching model -> native role assignment strip.
+			mounted.handleInput("\n"); // Assign the default role through SelectorController.
+			await assigned.promise;
+			await settings.flush();
+			await sessionManager.flush();
+			expect(ctx.showError).not.toHaveBeenCalled();
+			expect(session.model?.id).toBe(targetModel.id);
+			const selectedRole = settings.getModelRole("default");
+			if (!selectedRole) throw new Error("Expected a configured native default-role selector");
+			const resolvedRole = resolveModelRoleValue(selectedRole, [targetModel], { settings });
+			expect(resolvedRole.model?.provider).toBe(targetModel.provider);
+			expect(resolvedRole.model?.id).toBe(targetModel.id);
+			expect(resolvedRole.explicitThinkingLevel).toBe(true);
+			expect(resolvedRole.thinkingLevel).toBe(Effort.High);
+			expect(session.thinkingLevel).toBe(Effort.High);
+			expect(nativeSettings.getModelRole("default")).toBe(initialSelector);
+			expect(settings.getModelRole("judge")).toBe(initialSelector);
+			expect(cfgRetryFallbackChains.get(settings).judge).toEqual([targetSelector]);
+			expect(settings.getStorage()).toBe(nativeSettings.getStorage());
+			expect(await Bun.file(configPath).bytes()).toEqual(configBefore);
+			expect(await Bun.file(modelsPath).bytes()).toEqual(modelsBefore);
+			const sessionFile = sessionManager.getSessionFile();
+			if (!sessionFile) throw new Error("Expected persisted session file");
