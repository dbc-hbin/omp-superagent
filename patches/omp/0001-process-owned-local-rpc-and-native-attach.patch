+/** Actual CLI/PTY smoke provider: every response is local; no model API is contacted. */
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+import type { ExtensionAPI, ExtensionUIContext } from "@oh-my-pi/pi-coding-agent/extensibility/extensions";
+
+export default function socketHostSmoke(pi: ExtensionAPI): void {
+	let ui: ExtensionUIContext | undefined;
+	const mock = createMockModel({
+		id: "local",
+		provider: "socket-host-smoke",
+		handler: async context => {
+			const input = JSON.stringify(context.messages.at(-1)?.content);
+			if (input.includes("NATIVE_TUI_EDITABLE_LOCAL_PROMPT")) return { content: ["Socket host editable response"] };
+			if (input.includes("approval")) {
+				const allowed = await ui!.confirm("Smoke approval", "Allow the local smoke action?");
+				return { content: [allowed ? "Smoke approved" : "Smoke denied"] };
+			}
+			if (input.includes("slow")) return { content: ["Slow smoke completed"], delayMs: 600_000 };
+			return { content: ["Socket host smoke response"] };
+		},
+	});
+	pi.registerProvider("socket-host-smoke", {
+		baseUrl: "mock://socket-host-smoke",
+		api: "socket-host-smoke",
+		apiKey: "local-smoke-key",
+		streamSimple: mock.stream,
+		models: [{
+			id: "local", name: "Local socket host smoke", reasoning: false, input: ["text"],
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }, contextWindow: 32_768, maxTokens: 4096,
+		}],
+	});
+	pi.on("session_start", (_event, ctx) => { ui = ctx.ui; });
+}
