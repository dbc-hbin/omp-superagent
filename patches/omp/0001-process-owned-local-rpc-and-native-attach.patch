+import type { CollabFrame, EncodedFrame } from "./protocol";
+import type { CollabSocket } from "./relay-client";
+
+export type CollabGuestTransport = Pick<CollabSocket, "send" | "connect" | "close" | "onOpen" | "onFrame" | "onClose">;
+
+/** Existing Collab application frames, carried by the host's native RPC framing. */
+export class LocalCollabSocket implements CollabGuestTransport {
+	onOpen?: CollabGuestTransport["onOpen"];
+	onFrame?: CollabGuestTransport["onFrame"];
+	onClose?: CollabGuestTransport["onClose"];
+	#socket: net.Socket | undefined;
+	#closed = false;
+	#encoder = new RpcFrameEncoder();
+
+	constructor(readonly socketPath: string) {}
+
+	connect(): void {
+		validateRpcSocketPath(this.socketPath, true);
+		const socket = net.createConnection(this.socketPath);
+		this.#socket = socket;
+		const decoder = new StringDecoder("utf8");
+		const frames = new RpcFrameDecoder();
+		let pending = "";
+		let reason = "Host disconnected";
+		socket.on("data", data => {
+			pending += decoder.write(data);
+			let newline: number;
+			while ((newline = pending.indexOf("\n")) >= 0) {
+				const line = pending.slice(0, newline);
+				pending = pending.slice(newline + 1);
+				if (Buffer.byteLength(line) > MAX_RPC_FRAME_BYTES) { socket.destroy(); return; }
+				try {
+					const frame = frames.push(JSON.parse(line)) as Record<string, unknown> | undefined;
+					if (!frame) continue;
+					if (frame.type === "ready") {
+						socket.write(`${JSON.stringify({ type: "negotiate_protocol", protocolVersion: 2, id: "attach:protocol" })}\n`);
+					} else if (frame.type === "response" && frame.id === "attach:protocol") {
+						if (frame.success !== true) { reason = "Host refused protocol negotiation"; socket.destroy(); return; }
+						this.#encoder.setProtocolVersion(2);
+						this.onOpen?.();
+					} else if (typeof frame.t === "string") this.onFrame?.(frame as unknown as CollabFrame, 0);
+				} catch (error) { reason = `Invalid host frame: ${String(error)}`; socket.destroy(); return; }
+			}
+			if (Buffer.byteLength(pending) > MAX_RPC_FRAME_BYTES) socket.destroy();
+		});
+		socket.on("error", error => { reason = error.message; socket.destroy(); });
+		socket.on("close", () => { if (!this.#closed) this.onClose?.(reason, false); });
+	}
+
+	send(frame: CollabFrame | EncodedFrame): boolean {
+		if (!this.#socket || this.#closed || this.#socket.destroyed) return false;
+		const value = typeof frame === "string" ? JSON.parse(frame) as object : frame;
+		for (const line of this.#encoder.encodeFrames(value)) this.#socket.write(line);
+		return true;
+	}
+
+	close(): void {
+		this.#closed = true;
+		this.#socket?.destroy();
+	}
+}
diff --git a/packages/coding-agent/src/commands/attach.ts b/packages/coding-agent/src/commands/attach.ts
new file mode 100644
index 0000000..8e71e5b
--- /dev/null
+++ b/packages/coding-agent/src/commands/attach.ts
@@ -0,0 +1,27 @@
+import * as path from "node:path";
+import { Args, CliUsageError, Command, Flags } from "@oh-my-pi/pi-utils/cli";
+import { parseArgs } from "../cli/args";
+import { runRootCommand } from "../main";
+import { validateRpcSocketPath } from "../modes/rpc/rpc-socket-host";
+
+export default class Attach extends Command {
+	static description = "Attach the native TUI to a running local OMP host";
+	static args = { socket: Args.string({ description: "Absolute private RPC socket", required: true }) };
+	static flags = { "read-only": Flags.boolean({ description: "View only; cannot prompt, abort, or answer approvals", default: false }) };
+
+	async run(): Promise<void> {
+		const { args, flags } = await this.parse(Attach);
+		if (!process.stdin.isTTY || !process.stdout.isTTY) throw new CliUsageError("omp attach requires an interactive terminal");
+		if (!args.socket || !path.isAbsolute(args.socket)) throw new CliUsageError("omp attach requires an absolute socket path");
+		validateRpcSocketPath(args.socket, true);
+		const parsed = parseArgs([]);
+		parsed.noSession = true;
+		// A replica can edit its local UI but must never change the operator's native settings.
+		parsed.sessionSettings = true;
+		parsed.noExtensions = true;
+		parsed.noLsp = true;
+		parsed.noContextFiles = true;
+		parsed.attach = { socket: args.socket, readOnly: flags["read-only"] };
+		await runRootCommand(parsed, []);
+	}
+}
diff --git a/packages/coding-agent/src/modes/rpc/rpc-socket-host.ts b/packages/coding-agent/src/modes/rpc/rpc-socket-host.ts
new file mode 100644
index 0000000..ca9656c
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/rpc-socket-host.ts
@@ -0,0 +1,449 @@
+import * as fs from "node:fs";
+import * as net from "node:net";
+import * as path from "node:path";
+import { StringDecoder } from "node:string_decoder";
+import { isRecord } from "@oh-my-pi/pi-utils";
+import type { CollabUiRequestDraft } from "@oh-my-pi/pi-wire";
+import { CollabHost, type CollabHostTransport } from "../../collab/host";
+import type { CollabFrame, EncodedFrame } from "../../collab/protocol";
+import type { AgentSession } from "../../session/agent-session";
+import type { EventBus } from "../../utils/event-bus";
+import { MAX_RPC_FRAME_BYTES, RpcFrameDecoder, RpcFrameEncoder } from "./rpc-frame";
+import { RpcSessionEventForwarder } from "./rpc-session-events";
+import { RpcOutputWriter } from "./rpc-output";
+import type { RpcAgentSessionEventFrame, RpcExtensionUIRequest, RpcExtensionUIResponse, RpcSubagentSubscriptionLevel } from "./rpc-types";
+
+const MAX_OUTSTANDING_REQUESTS = 4096;
+const COMPLETION_COMMANDS = new Set(["prompt", "abort_and_prompt"]);
+const FIXED_SESSION_COMMANDS = new Set(["new_session", "open_session", "switch_session", "fork", "branch", "navigate_tree"]);
+
+/** No unlink-on-start: even an owned stale socket requires explicit operator cleanup. */
+export function validateRpcSocketPath(socketPath: string, existing = false): void {
+	if (!path.isAbsolute(socketPath) || Buffer.byteLength(socketPath) > 100) {
+		throw new Error("RPC socket must be an absolute Unix socket path of at most 100 bytes");
+	}
+	const directory = path.dirname(socketPath);
+	const stat = fs.lstatSync(directory);
+	if (!stat.isDirectory() || stat.isSymbolicLink() || stat.uid !== process.getuid?.() || (stat.mode & 0o777) !== 0o700) {
+		throw new Error("RPC socket directory must be owned by this user with mode 0700 (no symlink)");
+	}
+	if (existing) {
+		const socket = fs.lstatSync(socketPath);
+		if (!socket.isSocket() || socket.uid !== stat.uid || (socket.mode & 0o077) !== 0) {
+			throw new Error("RPC socket must be an owner-only socket owned by this user");
+		}
+	} else {
+		try {
+			fs.lstatSync(socketPath);
+		} catch (error) {
+			if ((error as NodeJS.ErrnoException).code === "ENOENT") return;
+			throw error;
+		}
+		throw new Error(`RPC socket path already exists; refusing to overwrite: ${socketPath}`);
+	}
+}
+
+interface Peer {
+	id: number;
+	socket: net.Socket;
+	encoder: RpcFrameEncoder;
+	writer: RpcOutputWriter;
+	kind: "rpc" | "collab" | undefined;
+	projector: RpcSessionEventForwarder;
+	subscription: RpcSubagentSubscriptionLevel;
+	requests: number;
+}
+
+interface RequestOwner {
+	peer: Peer;
+	id: unknown;
+	completion: boolean;
+	responseSeen?: boolean;
+	completionSeen?: boolean;
+	subscription?: RpcSubagentSubscriptionLevel;
+}
+
+/** One RPC runtime, many independently framed/correlated connections. */
+export class RpcSocketHost {
+	readonly input: ReadableStream<Uint8Array>;
+	readonly #session: AgentSession;
+	readonly #socketPath: string;
+	readonly #peers = new Map<number, Peer>();
+	readonly #requests = new Map<string, RequestOwner>();
+	readonly #calls = new Map<string, { peer: Peer; uri: boolean }>();
+	readonly #dialogs = new Map<string, { request: RpcExtensionUIRequest; abort: AbortController }>();
+	#controller!: ReadableStreamDefaultController<Uint8Array>;
+	#server: net.Server | undefined;
+	#socketIdentity: fs.Stats | undefined;
+	#ready: object | undefined;
+	#sequence = 0;
+	#requestSequence = 0;
+	#toolOwner: Peer | undefined;
+	#uriOwner: Peer | undefined;
+	#collab: CollabHost | undefined;
+	#closed = false;
+	#stopping = false;
+	#collabTransport: CollabHostTransport;
+
+	constructor(socketPath: string, session: AgentSession, subagentEventBus?: EventBus) {
+		this.#socketPath = socketPath;
+		this.#session = session;
+		this.input = new ReadableStream({ start: controller => { this.#controller = controller; } });
+		this.#collabTransport = {
+			send: (frame, target = 0) => this.#sendCollab(frame, target),
+			sendLatest: (_key, frame) => this.#sendCollab(frame),
+			broadcastAdvisory: frame => this.#sendCollab(frame),
+			sendBatch: (frames, target) => {
+				for (const frame of frames) if (!this.#sendCollab(frame, target)) return false;
+				return true;
+			},
+			isServing: id => this.#peers.get(id)?.kind === "collab",
+			isAdmitting: id => this.#peers.get(id)?.kind === "collab",
+			discardPendingSends: () => {
+				// net.Socket writes cannot be revoked. Close backed-up peers rather than
+				// allowing a goodbye to overtake their accepted snapshot or entries.
+				for (const peer of this.#peers.values()) if (peer.kind === "collab" && peer.socket.writableLength) peer.socket.destroy();
+			},
+			flush: () => this.#flush("collab"),
+			close: () => {
+				for (const peer of this.#peers.values()) if (peer.kind === "collab") peer.socket.end();
+			},
+		};
+		this.#collab = new CollabHost({ session, sessionManager: session.sessionManager, settings: session.settings, subagentEventBus });
+	}
+
+	async listen(): Promise<void> {
+		validateRpcSocketPath(this.#socketPath);
+		await this.#collab!.startLocal(this.#collabTransport);
+		this.#server = net.createServer(socket => this.#connect(socket));
+		const { promise, resolve, reject } = Promise.withResolvers<void>();
+		this.#server.once("error", reject);
+		this.#server.listen(this.#socketPath, () => {
+				try {
+					fs.chmodSync(this.#socketPath, 0o600);
+					this.#socketIdentity = fs.lstatSync(this.#socketPath);
+					this.#server!.off("error", reject);
+					resolve();
+				} catch (error) { reject(error); }
+		});
+		await promise.catch(async error => { await this.close(); throw error; });
+		this.#server.on("error", error => {
+			process.stderr.write(`RPC socket listener failed: ${error.message}\n`);
+			this.#controller.error(error);
+		});
+	}
+
+	#connect(socket: net.Socket): void {
+		const peer: Peer = { id: ++this.#sequence, socket, encoder: new RpcFrameEncoder(), kind: undefined, requests: 0,
+			writer: new RpcOutputWriter(socket, () => socket.destroy()),
+			projector: new RpcSessionEventForwarder(frame => this.#send(peer, frame)), subscription: "off" };
+		this.#peers.set(peer.id, peer);
+		if (this.#ready) this.#send(peer, this.#ready);
+		for (const dialog of this.#dialogs.values()) this.#send(peer, dialog.request);
+		const decoder = new StringDecoder("utf8");
+		const frames = new RpcFrameDecoder();
+		let pending = "";
+		socket.on("data", data => {
+			pending += decoder.write(data);
+			let newline: number;
+			while ((newline = pending.indexOf("\n")) >= 0) {
+				const line = pending.slice(0, newline);
+				pending = pending.slice(newline + 1);
+				if (Buffer.byteLength(line) > MAX_RPC_FRAME_BYTES) { socket.destroy(); return; }
+				if (!line.trim()) continue;
+				try {
+					const frame = frames.push(JSON.parse(line));
+					if (frame) this.#receive(peer, frame);
+				} catch (error) { this.#error(peer, undefined, "parse", String(error)); }
+			}
+			if (Buffer.byteLength(pending) > MAX_RPC_FRAME_BYTES) socket.destroy();
+		});
+		socket.on("error", () => socket.destroy());
+		socket.on("close", () => {
+			this.#peers.delete(peer.id);
+			this.#collabTransport.onControl?.({ t: "peer-left", peer: peer.id });
+			for (const [id, owner] of this.#calls) {
+				if (owner.peer !== peer) continue;
+				this.#calls.delete(id);
+				this.#failHostCall(id, owner.uri);
+			}
+			// Accepted work stays tracked until it settles, even without a return route.
+		});
+	}
+
+	#enqueue(frame: object): void {
+		if (!this.#closed) this.#controller.enqueue(new TextEncoder().encode(`${JSON.stringify(frame)}\n`));
+	}
+
+	#receive(peer: Peer, frame: unknown): void {
+		if (!isRecord(frame)) { this.#error(peer, undefined, "parse", "Expected an object"); return; }
+		if (this.#stopping) { this.#error(peer, frame.id, String(frame.type ?? frame.t), "Host is shutting down"); return; }
+		if (typeof frame.t === "string") {
+			if (peer.kind === "rpc") { peer.socket.destroy(); return; }
+			peer.kind = "collab";
+			this.#collabTransport.onFrame?.(frame as unknown as CollabFrame, peer.id);
+			return;
+		}
+		if (peer.kind === "collab") { peer.socket.destroy(); return; }
+		const type = frame.type;
+		if (typeof type !== "string") { this.#error(peer, frame.id, "parse", "Expected a command type"); return; }
+		if (type === "negotiate_protocol") {
+			if (frame.protocolVersion !== 2) this.#error(peer, frame.id, type, "Unsupported protocol version");
+			else {
+				this.#send(peer, { type: "response", id: frame.id, command: type, success: true, data: { protocolVersion: 2 } });
+				peer.encoder.setProtocolVersion(2);
+			}
+			return;
+		}
+		peer.kind = "rpc";
+		if (type === "set_event_filter") {
+			if (frame.events !== null && (!Array.isArray(frame.events) || !frame.events.every(event => typeof event === "string" && event.length > 0))) {
+				this.#error(peer, frame.id, type, "events must be null or an array of strings"); return;
+			}
+			const messageUpdates = frame.messageUpdates ?? "full";
+			if (messageUpdates !== "full" && messageUpdates !== "delta") {
+				this.#error(peer, frame.id, type, 'messageUpdates must be "full" or "delta"'); return;
+			}
+			const events = peer.projector.setFilter(frame.events as string[] | null, messageUpdates);
+			this.#send(peer, { type: "response", id: frame.id, command: type, success: true, data: { events, messageUpdates } });
+			return;
+		}
+		if (type === "extension_ui_response") { this.#answerUi(frame as unknown as RpcExtensionUIResponse); return; }
+		if (type === "host_tool_result" || type === "host_tool_update" || type === "host_uri_result") {
+			const owner = this.#calls.get(String(frame.id));
+			if (owner?.peer !== peer) return;
+			if (type !== "host_tool_update") this.#calls.delete(String(frame.id));
+			this.#enqueue(frame);
+			return;
+		}
+		if (FIXED_SESSION_COMMANDS.has(type)) {
+			this.#error(peer, frame.id, type, "A socket host owns one explicit session; start another host process for another session"); return;
+		}
+		if (type === "set_host_tools" || type === "set_host_uri_schemes") {
+			const owner = type === "set_host_tools" ? this.#toolOwner : this.#uriOwner;
+			const definitions = type === "set_host_tools" ? frame.tools : frame.schemes;
+			if (owner && owner !== peer && (this.#peers.has(owner.id) || !Array.isArray(definitions) || definitions.length === 0)) {
+				this.#error(peer, frame.id, type, "Another connected client owns this host capability"); return;
+			}
+			if (type === "set_host_tools") this.#toolOwner = peer;
+			else this.#uriOwner = peer;
+		}
+		if (peer.requests >= 256 || this.#requests.size >= MAX_OUTSTANDING_REQUESTS) {
+			this.#error(peer, frame.id, type, "Too many outstanding requests"); return;
+		}
+		const subscription = type === "set_subagent_subscription" ? frame.level : undefined;
+		if (subscription !== undefined && subscription !== "off" && subscription !== "progress" && subscription !== "events") {
+			this.#error(peer, frame.id, type, "Invalid subagent subscription level"); return;
+		}
+		const id = `socket:${++this.#requestSequence}`;
+		peer.requests++;
+		this.#requests.set(id, { peer, id: frame.id, completion: COMPLETION_COMMANDS.has(type), subscription });
+		this.#enqueue({ ...frame, id, ...(subscription !== undefined ? { level: "events" } : {}) });
+	}
+
+	#error(peer: Peer, id: unknown, command: string, error: string): void {
+		this.#send(peer, { type: "response", id, command, success: false, error });
+	}
+
+	#send(peer: Peer, frame: object): boolean {
+		if (peer.socket.destroyed) return false;
+		try {
+			peer.writer.write(peer.encoder.encodeFrames(frame));
+			return !peer.socket.destroyed;
+		} catch { peer.socket.destroy(); return false; }
+	}
+
+	#sendCollab(frame: CollabFrame | EncodedFrame, target = 0): boolean {
+		const value = typeof frame === "string" ? JSON.parse(frame) as object : frame;
+		if (target) {
+			const peer = this.#peers.get(target);
+			return peer?.kind === "collab" ? this.#send(peer, value) : false;
+		}
+		let sent = false;
+		for (const peer of this.#peers.values()) if (peer.kind === "collab") sent = this.#send(peer, value) || sent;
+		return sent;
+	}
+
+	output(frame: object): void {
+		if (!isRecord(frame)) return;
+		if (frame.type === "ready") this.#ready = frame;
+		if (frame.type === "response" || frame.type === "prompt_result") {
+			const owner = this.#requests.get(String(frame.id));
+			if (!owner) return;
+			if (frame.type === "response" && frame.command === "shutdown_host" && frame.success === true) this.#stopping = true;
+			if (owner.subscription !== undefined && frame.success === true) owner.peer.subscription = owner.subscription;
+			const data = frame.command === "get_state" && frame.success === true && isRecord(frame.data)
+				? { data: { ...frame.data, pendingUiRequests: [...this.#dialogs.values()].map(dialog => dialog.request) } }
+				: owner.subscription !== undefined && frame.success === true ? { data: { level: owner.subscription } } : {};
+			this.#send(owner.peer, { ...frame, id: owner.id, ...data });
+			let done = !owner.completion;
+			if (frame.type === "prompt_result") {
+				owner.completionSeen = true;
+				done = owner.responseSeen === true;
+			} else if (!owner.responseSeen) {
+				owner.responseSeen = true;
+				done ||= owner.completionSeen === true || frame.success === false || isRecord(frame.data) && frame.data.agentInvoked === false;
+			}
+			if (done) {
+				this.#requests.delete(String(frame.id));
+				owner.peer.requests--;
+			}
+			return;
+		}
+		if (frame.type === "host_tool_call" || frame.type === "host_uri_request") {
+			const uri = frame.type === "host_uri_request";
+			const peer = uri ? this.#uriOwner : this.#toolOwner;
+			if (peer && this.#peers.has(peer.id) && this.#send(peer, frame)) this.#calls.set(String(frame.id), { peer, uri });
+			else this.#failHostCall(String(frame.id), uri);
+			return;
+		}
+		if (frame.type === "host_tool_cancel" || frame.type === "host_uri_cancel") {
+			const owner = this.#calls.get(String(frame.targetId));
+			if (owner) { this.#send(owner.peer, frame); this.#calls.delete(String(frame.targetId)); }
+			return;
+		}
+		if (frame.type === "extension_ui_request") this.#mirrorUi(frame as RpcExtensionUIRequest);
+		for (const peer of this.#peers.values()) {
+			if (peer.kind === "collab") continue;
+			if ((frame.type === "subagent_lifecycle" || frame.type === "subagent_progress") && peer.subscription === "off") continue;
+			if (frame.type === "subagent_event" && peer.subscription !== "events") continue;
+			this.#send(peer, frame);
+		}
+	}
+
+	sessionEvent(frame: RpcAgentSessionEventFrame): void {
+		for (const peer of this.#peers.values()) if (peer.kind !== "collab") peer.projector.forwardStamped(frame);
+	}
+
+	isBusy(): boolean {
+		return this.#requests.size > 1 || this.#calls.size > 0 || this.#dialogs.size > 0;
+	}
+
+	#failHostCall(id: string, uri: boolean): void {
+		const error = "Owning RPC client disconnected; host capability is unavailable until its owner reconnects and registers";
+		this.#enqueue(uri ? { type: "host_uri_result", id, isError: true, error } : {
+			type: "host_tool_result", id, isError: true, result: { content: [{ type: "text", text: error }] },
+		});
+	}
+
+	#answerUi(response: RpcExtensionUIResponse): void {
+		const pending = this.#dialogs.get(response.id);
+		if (!pending) return;
+		const request = pending.request;
+		const valid = "cancelled" in response && response.cancelled === true ||
+			request.method === "confirm" && "confirmed" in response && typeof response.confirmed === "boolean" ||
+			(request.method === "editor" || request.method === "input") && "value" in response && typeof response.value === "string" ||
+			request.method === "select" && "value" in response && request.options.includes(response.value) ||
+			request.method === "ask" && "answers" in response && Array.isArray(response.answers) &&
+			response.answers.length === request.questions.length && request.questions.every((question, index) => {
+				const answer = response.answers[index];
+				return answer?.id === question.id && Array.isArray(answer.selectedOptions) &&
+					answer.selectedOptions.every(option => question.options.some(candidate => candidate.label === option)) &&
+					(question.multi || answer.selectedOptions.length <= 1) &&
+					(answer.customInput === undefined || typeof answer.customInput === "string");
+			});
+		if (!valid) return;
+		this.#dialogs.delete(response.id);
+		pending.abort.abort();
+		this.#enqueue(response);
+		for (const peer of this.#peers.values()) if (peer.kind !== "collab") this.#send(peer, {
+			type: "extension_ui_request", id: `settled:${response.id}`, method: "cancel", targetId: response.id,
+		});
+	}
+
+	#mirrorUi(request: RpcExtensionUIRequest): void {
+		if (request.method === "cancel") {
+			this.#dialogs.get(request.targetId)?.abort.abort();
+			this.#dialogs.delete(request.targetId);
+			return;
+		}
+		if (!["select", "confirm", "input", "editor", "ask"].includes(request.method)) return;
+		const abort = new AbortController();
+		this.#dialogs.set(request.id, { request, abort });
+		void this.#presentUi(request, abort.signal).then(response => {
+			if (response) this.#answerUi(response);
+		}).catch(error => this.#session.emitNotice("warning", `Native attach dialog failed: ${String(error)}`, "rpc-attach"));
+	}
+
+	async #presentUi(request: RpcExtensionUIRequest, signal: AbortSignal): Promise<RpcExtensionUIResponse | undefined> {
+		const ask = async (draft: CollabUiRequestDraft) => {
+			const result = await this.#collab?.requestGuestUi(draft, signal, { retainOnReconnect: true });
+			return result?.kind === "answered" ? result : undefined;
+		};
+		const id = request.id;
+		if (request.method === "ask") {
+			const answers: Array<{ id: string; selectedOptions: string[]; customInput?: string }> = [];
+			for (const question of request.questions) {
+				const selectedOptions: string[] = [];
+				let customInput: string | undefined;
+				const labels = question.options.map(option => option.label);
+				const other = "Other (enter text)…";
+				const done = "Submit selections";
+				while (!signal.aborted) {
+					const result = await ask({ kind: "select", title: question.question, options: [...labels, other, ...(question.multi ? [done] : [])], initialIndex: question.recommended,
+						selectionMarker: question.multi ? "checkbox" : undefined, markableCount: labels.length,
+						checkedIndices: selectedOptions.map(label => labels.indexOf(label)) });
+					if (!result) return;
+					if (result.value === undefined) return { type: "extension_ui_response", id, cancelled: true };
+					if (result.value === done) break;
+					if (result.value === other) {
+						const input = await ask({ kind: "editor", title: question.question });
+						if (!input) return;
+						if (input.value === undefined) continue;
+						customInput = input.value;
+						break;
+					}
+					if (!labels.includes(result.value)) continue;
+					const index = selectedOptions.indexOf(result.value);
+					if (index >= 0) selectedOptions.splice(index, 1);
+					else selectedOptions.push(result.value);
+					if (!question.multi) break;
+				}
+				if (signal.aborted) return;
+				answers.push({ id: question.id, selectedOptions, customInput });
+			}
+			return { type: "extension_ui_response", id, answers };
+		}
+		let draft: CollabUiRequestDraft;
+		if (request.method === "select") draft = { kind: "select", title: request.title, options: request.options.map((label, index) => ({ label, description: request.optionDetails?.[index]?.description })), initialIndex: request.initialIndex,
+			selectionMarker: request.selectionMarker, checkedIndices: request.checkedIndices, markableCount: request.markableCount };
+		else if (request.method === "confirm") draft = { kind: "select", title: request.title, helpText: request.message, options: ["Yes", "No"], approval: true };
+		else if (request.method === "editor") draft = { kind: "editor", title: request.title, prefill: request.prefill };
+		else if (request.method === "input") draft = { kind: "editor", title: request.title };
+		else return;
+		const result = await ask(draft);
+		if (!result || signal.aborted) return;
+		if (result.value === undefined) return { type: "extension_ui_response", id, cancelled: true };
+		return request.method === "confirm" ? { type: "extension_ui_response", id, confirmed: result.value === "Yes" } : { type: "extension_ui_response", id, value: result.value };
+	}
+
+	async #flush(kind?: Peer["kind"]): Promise<void> {
+		await Promise.all([...this.#peers.values()].filter(peer => !kind || peer.kind === kind).map(async peer => {
+			// A stalled viewer must not hold the host's persisted shutdown hostage.
+			const timeout = setTimeout(() => peer.socket.destroy(), 1000);
+			try { await peer.writer.close(); } catch { peer.socket.destroy(); }
+			finally { clearTimeout(timeout); }
+		}));
+	}
+
+	async close(): Promise<void> {
+		if (this.#closed) return;
+		this.#closed = true;
+		for (const pending of this.#dialogs.values()) pending.abort.abort();
+		this.#dialogs.clear();
+		await this.#collab?.stop("Host shut down");
+		await this.#flush();
+		for (const peer of this.#peers.values()) peer.socket.destroy();
+		if (this.#server?.listening) {
+			const { promise, resolve } = Promise.withResolvers<void>();
+			this.#server.close(() => resolve());
+			await promise;
+		}
+		if (this.#socketIdentity) {
+			try {
+				const stat = fs.lstatSync(this.#socketPath);
+				if (stat.ino === this.#socketIdentity.ino && stat.dev === this.#socketIdentity.dev) fs.unlinkSync(this.#socketPath);
+			} catch (error) { if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error; }
+		}
+	}
+}
