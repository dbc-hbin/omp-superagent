+
+	it.each([false, true])("selects the native settings boundary before auth discovery (enabled=%s)", async enabled => {
+		const nativeSettings = Settings.isolated({
+			modelRoles: { default: "anthropic/claude-sonnet-4-5", judge: "native-judge/decisions" },
+			"retry.fallbackChains": { judge: ["backup-judge/decisions"] },
