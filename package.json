{
  "name": "omp-superagent",
  "version": "0.1.6",
  "description": "One messenger-connected OMP head with independent work sessions",
  "license": "MIT",
  "author": "dbc-hbin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbc-hbin/omp-superagent.git"
  },
  "homepage": "https://github.com/dbc-hbin/omp-superagent#readme",
  "bugs": "https://github.com/dbc-hbin/omp-superagent/issues",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "files": [
    "bin/omp-sa-worker",
    "src/",
    "scripts/",
    "skills/",
    "host-owner/bin/",
    "worker-launcher/omp-sa-worker-launcher.c",
    "gateway/bin/",
    "upstream/ulw.json",
    "assets/",
    "docs/",
    "config.example.json",
    "DESIGN.md",
    "README.ko.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": {
    "omp-sa": "src/cli.ts",
    "omp-sa-worker": "bin/omp-sa-worker"
  },
  "scripts": {
    "build:owner": "bun --no-env-file scripts/build-host-owner.ts --owner",
    "build:worker-launcher": "bun --no-env-file scripts/build-worker-launcher.ts",
    "setup:macos-worker": "bun --no-env-file src/worker-macos-setup.ts",
    "build:native": "bun --no-env-file scripts/build-host-owner.ts",
    "check": "tsc --noEmit",
    "test": "bun run build:native && bun test test",
    "test:ci": "bun --no-env-file scripts/ci.ts",
    "test:baseline": "bash scripts/test-omp.sh",
    "release": "bun --no-env-file scripts/release.ts",
    "start": "bun --no-env-file src/cli.ts start",
    "setup": "bash scripts/setup.sh",
    "prepare:ulw": "bun scripts/prepare-ulw.ts",
    "prepare": "bun run build:native --install",
    "postinstall": "bun scripts/prepare-ulw.ts"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "@oh-my-pi/pi-ai": "19.0.0",
    "@oh-my-pi/pi-catalog": "19.0.0",
    "@oh-my-pi/pi-coding-agent": "19.0.0",
    "@oh-my-pi/pi-natives": "19.0.0",
    "@oh-my-pi/pi-tui": "19.0.0",
    "@oh-my-pi/pi-utils": "19.0.0",
    "@slack/web-api": "^8.3.0",
    "@sinclair/typebox": "^0.34.41",
    "abort-controller": "3.0.0",
    "cron-parser": "5.10.6",
    "discord.js": "^14.25.1",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@discordjs/voice": "0.19.2",
    "@noble/ciphers": "2.4.0",
    "@slack/socket-mode": "^3.2.0",
    "@types/bun": "^1.3.0",
    "opusscript": "0.0.8",
    "typescript": "^7.0.2"
  }
}
