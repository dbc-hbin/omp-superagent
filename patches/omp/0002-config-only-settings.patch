 	 */
 	static loadReadOnly(options: SettingsOptions = {}): Promise<Settings> {
 		return Promise.try(() => new Settings({ ...options, readOnly: true }).#loadReadOnly());
+	}
+
+	/**
+	 * Edit config through native locked persistence without opening account storage,
+	 * migrating legacy state, binding runtime effects, or changing the singleton.
+	 */
+	static async loadConfigOnly(
+		options: Omit<SettingsOptions, "inMemory" | "readOnly"> = {},
+	): Promise<Settings> {
+		const instance = await new Settings({ ...options, inMemory: false, readOnly: true }).#loadReadOnly();
+		// Creating config.yml would hide settings that normal startup still needs
+		// to migrate. Do not inspect/migrate an account database to guess its contents.
+		if (!fs.existsSync(instance.#configPath!) &&
+			(fs.existsSync(path.join(instance.#agentDir, "settings.json")) ||
+				fs.existsSync(getAgentDbPath(instance.#agentDir)))) {
+			throw new Error("Migrate legacy settings with normal OMP before config-only writes");
+		}
+		instance.#persist = true;
+		return instance;
 	}
 
