+				const restored = resumed.buildSessionContext();
+				expect(getRestorableSessionModels(restored.models, resumed.getLastModelChangeRole())[0]).toBe(targetSelector);
+			} finally {
+				await resumed.close();
+			}
+		} finally {
+			if (mounted instanceof ModelHubComponent) mounted.dispose();
+			await session.dispose();
+			nativeSettings.cancelPendingSaves();
+			authStorage.close();
+		}
+	});
+});
